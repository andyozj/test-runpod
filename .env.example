# Every variable either settings module reads, plus the build-time and
# compose passthrough values. Copy to `.env`; `.env` is git-ignored.
# Defaults shown are the code defaults: an unset variable uses them.

# --- RunPod: required to call the endpoint -----------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# --- HuggingFace: BUILD time only, passed as a BuildKit secret ---------------
# Requires accepting the FLUX.1-dev licence at
# https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=

# --- GHCR: build/push only, never read by either app -------------------------
# GHCR_TOKEN must be a *classic* PAT with `write:packages`; fine-grained
# tokens have no packages scope. Used as:
#   echo $GHCR_TOKEN | docker login ghcr.io -u $GHCR_USER --password-stdin
GHCR_USER=
GHCR_TOKEN=

# --- Worker runtime (worker/src/worker/settings.py) --------------------------
# Set on the RunPod endpoint, never baked into the image.
# MODEL_ID: HuggingFace repository the weights come from.
MODEL_ID=black-forest-labs/FLUX.1-dev
# MODEL_REVISION: reported, not pinned. Discovered from the staged snapshot or
# the baked MANIFEST.json; set this only for layouts carrying no evidence.
MODEL_REVISION=unknown
# WEIGHTS_PATH: explicit diffusers-layout directory (baked image or mounted
# volume). Leave UNSET on a cached-models endpoint: it wins over the cache, so
# setting it there means the pre-staged weights go unused.
WEIGHTS_PATH=/opt/weights
# MODEL_CACHE_ROOT: HuggingFace cache hub dir where RunPod stages a cached
# model. Used only when WEIGHTS_PATH is absent.
MODEL_CACHE_ROOT=/runpod-volume/huggingface-cache/hub

# --- Gateway runtime (gateway/src/gateway/settings.py) -----------------------
# GATEWAY_API_KEYS: required, no built-in default. Comma-separated
# `key_id:secret` pairs; an unset or empty value fails startup. compose.yaml
# supplies demo:local-development-key when this is unset, for local runs only.
GATEWAY_API_KEYS=
# RECONCILE_INTERVAL_S: reconciler tick while work is outstanding.
RECONCILE_INTERVAL_S=2.0
# RECONCILE_IDLE_INTERVAL_S: reconciler tick when nothing is unresolved.
RECONCILE_IDLE_INTERVAL_S=10.0
# RECONCILE_BATCH: jobs claimed per tick.
RECONCILE_BATCH=50
# JOB_DEADLINE_S: age at which an unresolved job is timed out. Must stay above
# the endpoint execution timeout.
JOB_DEADLINE_S=600
# MAX_QUEUE_WAIT_S: estimated wait above which submissions are shed with 429.
MAX_QUEUE_WAIT_S=120.0
# AVG_JOB_S: expected job duration feeding the queue-wait estimate.
AVG_JOB_S=22.0
# SUBMIT_GRACE_S: floor on how long a job with no upstream id is left alone
# before the reconciler may adopt it. A floor, not the answer: the composition
# root raises it to the client's worst-case submit retry envelope, so a value
# below that cannot reopen the double-submit window.
SUBMIT_GRACE_S=30.0
# HEALTH_MAX_AGE_S: age beyond which a queue reading is treated as unknown, so
# a dead reconciler cannot shed traffic forever.
HEALTH_MAX_AGE_S=30.0
# MAX_ACTIVE_JOBS_PER_KEY: non-terminal job cap per caller; over the cap gets
# 429 QUEUE_SATURATED with Retry-After.
MAX_ACTIVE_JOBS_PER_KEY=10
# VERSION: reported by the health endpoints. Baked into the gateway image via
# the `VERSION` build arg (gateway/Dockerfile); compose passes it through.
VERSION=0.1.0
