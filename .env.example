# RunPod — required to call the endpoint
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# HuggingFace — required at BUILD time only, passed as a BuildKit secret.
# Requires accepting the FLUX.1-dev licence at
# https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=

# Worker runtime. Set on the RunPod endpoint, never baked into the image.
# The model revision is discovered from the staged snapshot, not configured.
WEIGHTS_PATH=/opt/weights

# Gateway — required, no built-in default. Comma-separated `key_id:secret`
# pairs; an unset or empty value fails the gateway at startup. compose.yaml
# supplies demo:local-development-key when this is left unset, for local
# runs only — set your own before exposing the port.
GATEWAY_API_KEYS=

# Gateway — non-terminal job cap per API key. Default 10 if unset.
MAX_ACTIVE_JOBS_PER_KEY=10
