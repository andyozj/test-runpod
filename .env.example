# RunPod — required to call the endpoint
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# HuggingFace — required at BUILD time only, passed as a BuildKit secret.
# Requires accepting the FLUX.1-dev licence at
# https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=

# Worker runtime. Set on the RunPod endpoint, never baked into the image.
WEIGHTS_PATH=/opt/weights
MODEL_REVISION=
STORAGE_ENABLED=false
LOG_LEVEL=INFO
